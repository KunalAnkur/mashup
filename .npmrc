# @movmash packages live on GitHub Packages, not on npmjs.org.
#
# No secret here: ${NPM_TOKEN} is read from the environment, so this file is safe to
# commit and works identically both locally and on Vercel, where NPM_TOKEN is set as
# an environment variable.
#
# pnpm fails loudly if NPM_TOKEN is unset — "Failed to replace env in config" — which
# is the right behaviour: an empty token would otherwise 401 much later and less
# clearly.
@movmash:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
